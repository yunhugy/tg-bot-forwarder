# ===== 必填 =====
# BotFather 给的 token（不要带 bot 前缀）
TG_BOT_TOKEN=

# 管理员 Telegram 用户 ID（默认 6609386680，可不填）
ADMIN_ID=6609386680

# ===== 选填 =====
# 用户发消息后是否自动回执“已收到”（默认 true）
ECHO_MODE=true

# 本地管理接口鉴权 token（强烈建议设置！用于 /stats、/user 查询）
# 留空则管理接口一律返回 403
HTTP_TOKEN=

# 本地管理接口端口（只监听 127.0.0.1，默认 8787）
HTTP_PORT=8787

# 数据目录（默认 ./data）
DATA_DIR=

# 启动时是否丢弃切换前的积压消息（默认 true；设为 false 则逐条补发）
DROP_PENDING=true

# 轮询超时秒数 5~50（默认 50）
POLL_TIMEOUT=50

# ===== GitHub 拉黑名单同步（选填，不填则只用本地存储）=====
# 需要一个有该仓库 contents:write 权限的 token（fine-grained PAT 即可）
GITHUB_TOKEN=
GITHUB_OWNER=yunhugy
GITHUB_REPO=tg-bot-forwarder
GITHUB_BANS_PATH=bans.json
